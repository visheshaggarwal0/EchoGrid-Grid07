# EchoGrid Environment Variables

# Optional: Groq API Key if using ChatGroq instead of local Ollama
GROQ_API_KEY=gsk_your_fake_key_here_do_not_commit

# Optional: Real SearxNG instance URL for Phase 2 (Currently mocked)
SEARXNG_URL=http://localhost:8080

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
